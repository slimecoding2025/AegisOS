# AegisOS ISO build profile. Sourced by scripts/build.sh.
# Debian base verified 2026-10-03: Debian 13 "trixie" is stable (see docs/ARCHITECTURE.md).
AEGIS_DEBIAN_SUITE=trixie
AEGIS_ARCH=amd64
AEGIS_ARCHIVE_AREAS="main contrib non-free-firmware"
# UEFI only. BIOS is NOT supported in 0.x.
AEGIS_BOOTLOADERS=grub-efi
# live = Debian Installer in live mode (NOT VERIFIED); none = live image without installer.
AEGIS_INSTALLER=live
